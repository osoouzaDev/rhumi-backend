NODE_ENV=production
PORT=8000
CORS_ORIGINS=https://staging.rhumi.example
TRUST_PROXY_HOPS=1
FORCE_HTTPS=true
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
SERVICE_NAME=rhumi-api-staging
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME_RANDOM_METRICS_TOKEN

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=60
ACCOUNT_RECOVERY_RATE_LIMIT_WINDOW_MS=900000
ACCOUNT_RECOVERY_RATE_LIMIT_MAX=10
RATE_LIMIT_STORE=redis
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_KEY_PREFIX=rhumi:staging:rate-limit:
REDIS_CONNECT_TIMEOUT_MS=10000

# Utilize exclusivamente a credencial restrita rhumi_app.
DATABASE_URL=postgresql://rhumi_app:CHANGE_ME_APP_DB_PASSWORD@CHANGE_ME_DB_HOST:CHANGE_ME_DB_PORT/CHANGE_ME_DB_NAME?sslmode=verify-full
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=/run/secrets/postgresql-ca.pem
DB_POOL_MAX=10

JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_WITH_AT_LEAST_48_CHARACTERS
JWT_PREVIOUS_SECRET=
JWT_ISSUER=rhumi-api
JWT_AUDIENCE=rhumi-staging-client
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
AUTH_COOKIES_ENABLED=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_EXPOSE_TOKENS_IN_BODY=false
AUTH_MAX_ACTIVE_SESSIONS=10
ACCOUNT_TOKENS_EXPOSE_IN_RESPONSE=false
ACCOUNT_ACTIVATION_EXPIRES_IN_HOURS=72
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PUBLIC_APP_URL=https://staging.rhumi.example

MFA_ENABLED=true
MFA_REQUIRE_ADMINISTRATORS=true
MFA_ENCRYPTION_KEY=CHANGE_ME_32_RANDOM_BYTES_IN_BASE64
MFA_ISSUER=RHumi Staging
MFA_CHALLENGE_EXPIRES_IN_SECONDS=300
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=10

# O Mailpit captura mensagens no ambiente de homologação.
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@staging.rhumi.example
EMAIL_FROM_NAME=RHumi Homologação
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_LOCK_TIMEOUT_MINUTES=15
NOTIFICATION_AUTOMATION_ENABLED=true
NOTIFICATION_AUTOMATION_INTERVAL_MS=60000

FILE_STORAGE_PATH=/app/var/private-files
FILE_MAX_BYTES=20971520
FILE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
FILE_DOWNLOAD_TOKEN_EXPIRES_IN_MINUTES=30
FILE_ANTIVIRUS_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
FILE_RETENTION_CLEANUP_ENABLED=true
FILE_RETENTION_CLEANUP_INTERVAL_MS=3600000

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
