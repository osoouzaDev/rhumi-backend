# Copie para /etc/rhumi/staging.dependencies.env com permissão 0600.
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD

# Em um ambiente controlado, substitua as tags por referências @sha256.
RHUMI_REDIS_IMAGE=redis:7-alpine
RHUMI_MAILPIT_IMAGE=axllent/mailpit:v1
RHUMI_CLAMAV_IMAGE=clamav/clamav:stable
RHUMI_PROMETHEUS_IMAGE=prom/prometheus:latest
