# Instale como /etc/rhumi/backup.env com permissão 0600.
BACKUP_DATABASE_URL=postgresql://CHANGE_ME_BACKUP_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DB_HOST:CHANGE_ME_DB_PORT/CHANGE_ME_DB_NAME?sslmode=verify-full
RESTORE_TEST_ADMIN_URL=postgresql://CHANGE_ME_RESTORE_ADMIN:CHANGE_ME_PASSWORD@CHANGE_ME_RESTORE_HOST:5432/postgres?sslmode=verify-full
BACKUP_OUTPUT_DIR=/var/backups/rhumi
FILE_BACKUP_SOURCE=/var/lib/rhumi/files
FILE_BACKUP_OUTPUT_DIR=/var/backups/rhumi-files
