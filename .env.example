NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
FORCE_HTTPS=false
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
SERVICE_NAME=rhumi-api
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-a-random-monitoring-token

GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=60
ACCOUNT_RECOVERY_RATE_LIMIT_WINDOW_MS=900000
ACCOUNT_RECOVERY_RATE_LIMIT_MAX=10

# Use redis quando houver mais de uma instância da API.
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_KEY_PREFIX=rhumi:rate-limit:
REDIS_CONNECT_TIMEOUT_MS=10000

# Credenciais restritas usadas pela API em execução.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=rhumi_app
DB_PASSWORD=replace-with-a-random-app-database-password
DB_NAME=rhumi
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=
DB_POOL_MAX=10

# Credenciais administrativas usadas somente por migrations, seed e provisionamento.
DATABASE_MIGRATION_URL=
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=replace-with-the-migration-password

JWT_SECRET=replace-with-at-least-48-random-characters
JWT_PREVIOUS_SECRET=
JWT_ISSUER=rhumi-api
JWT_AUDIENCE=rhumi-client
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
AUTH_COOKIES_ENABLED=true
AUTH_COOKIE_SAME_SITE=lax
# Em produção, mantenha false para não expor tokens ao JavaScript.
AUTH_EXPOSE_TOKENS_IN_BODY=false
AUTH_MAX_ACTIVE_SESSIONS=10
ACCOUNT_TOKENS_EXPOSE_IN_RESPONSE=false
ACCOUNT_ACTIVATION_EXPIRES_IN_HOURS=72
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PUBLIC_APP_URL=http://localhost:3000

# Gere uma chave independente: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENABLED=false
MFA_REQUIRE_ADMINISTRATORS=false
MFA_ENCRYPTION_KEY=
MFA_ISSUER=RHumi
MFA_CHALLENGE_EXPIRES_IN_SECONDS=300
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODE_COUNT=10

EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=RHumi
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_LOCK_TIMEOUT_MINUTES=15
NOTIFICATION_AUTOMATION_ENABLED=false
NOTIFICATION_AUTOMATION_INTERVAL_MS=60000

# Arquivos privados e LGPD
FILE_STORAGE_PATH=./var/private-files
FILE_MAX_BYTES=20971520
FILE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
FILE_DOWNLOAD_TOKEN_EXPIRES_IN_MINUTES=30
FILE_ANTIVIRUS_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
FILE_RETENTION_CLEANUP_ENABLED=true
FILE_RETENTION_CLEANUP_INTERVAL_MS=3600000

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Usadas somente por npm run db:seed; remova-as do ambiente após o bootstrap.
SEED_COMPANY_LEGAL_NAME=Empresa Exemplo LTDA
SEED_COMPANY_TAX_ID=00.000.000/0001-00
SEED_ADMIN_NAME=Administrador RH
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_EMPLOYEE_CODE=ADMIN001
